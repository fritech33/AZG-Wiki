{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AZG-Wiki",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#166534"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:simon.lauber@gmx.ch",
        "label": "Feedback"
      }
    ]
  },
  "search": {
    "prompt": "Suchen …"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "languages": [
      {
        "language": "de",
        "groups": [
          {
            "group": "Überblick",
            "pages": [
              "Start"
            ]
          },
          {
            "group": "AZG-Regelungen",
            "pages": [
              "Arbeitszeit_pro_Arbeitstag",
              "Pausen_und_Arbeitsunterbrechung",
              "Die_Ruheschicht",
              "Die_Ruhetage",
              "Ferien"
            ]
          }
        ],
        "default": true,
        "hidden": true
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/Start",
      "permanent": true
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "Seite nicht gefunden",
      "description": "*Die Seite scheint nicht vorhanden zu sein.*"
    }
  },
  "description": "Eine Übersicht über das Arbeitszeitgesetz im Fahrdienst (Schweiz)."
}
