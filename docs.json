{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AZG-Wiki",
  "colors": {
    "primary": "#16A34A",
    "light": "#4fc47a",
    "dark": "#1f663a"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:simon.lauber@gmx.ch",
        "label": "Feedback"
      }
    ]
  },
  "search": {
    "prompt": "Suchen …"
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "languages": [
      {
        "language": "de",
        "default": true,
        "hidden": true,
        "groups": [
          {
            "group": "Überblick",
            "pages": [
              "Start"
            ],
            "expanded": true
          },
          {
            "group": "AZG-Regelungen",
            "pages": [
              "Arbeitszeit_pro_Arbeitstag",
              "Pausen_und_Arbeitsunterbrechung",
              "Die_Ruheschicht",
              "Die_Ruhetage",
              "Ferien"
            ],
            "expanded": true
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "Start",
      "permanent": true
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "Seite nicht gefunden",
      "description": "*Die Seite scheint nicht vorhanden zu sein.*"
    }
  },
  "description": "Eine Übersicht über das Arbeitszeitgesetz im Fahrdienst (Schweiz).",
  "interaction": {
    "drilldown": true
  },
  "background": {
    "color": {
      "light": "#FADADD"
    }
  }
}
